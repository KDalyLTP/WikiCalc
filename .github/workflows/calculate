name: Calculate NOI, Cost, and Income Yield

on:
  workflow_dispatch:

jobs:
  calculate:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install Python dependencies
        run: pip install -r requirements.txt

      - name: Run calculations
        run: python calculate.py

      - name: Upload calculated report artifact
        uses: actions/upload-artifact@v4
        with:
          name: calculated-reports
          path: data/output/*.json
          retention-days: 30
